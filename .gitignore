# ============================================================
#  个人数据 —— 绝对不要提交
#
#  这个项目会生成含你真实姓名、手机、邮箱、学号、学校、简历的文件。
#  下面这些路径一旦提交并推到公开仓库，即使后来删除也可能已被缓存。
# ============================================================

# 简历事实库：含全部身份信息
data/resume/facts.yaml

# 数据库：含投递记录，且 profile 可能被写入
data/jobs.db
data/jobs.db-journal
data/jobs.db-wal
data/jobs.db-shm

# 日志与快照（含本机路径）
data/logs/
data/raw/

# 本地配置覆盖（把真实个人信息放这里，config.yaml 保持占位符）
config.local.yaml

# ------------------------------------------------------------
#  生成产物 —— 由脚本生成，不需要提交
# ------------------------------------------------------------

dashboard.html
今日投递清单.md

# 生成的简历（含姓名/电话/邮箱/GitHub）
resume/output/

# 生成的书签（含浏览器可直接执行的完整个人信息）
apply/autofill.js
apply/bookmarklet.html

# 按公司生成的题库与面试复盘（含个人经历）
interview/question_bank/*.md
interview/retro/*.md

# ------------------------------------------------------------
#  语言 / 编辑器 / 系统
# ------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class

.vscode/
.idea/
*.swp
*.swo

Thumbs.db
.DS_Store
desktop.ini

# 临时文件
*.tmp
_preview*.png
_pagebreak.png
